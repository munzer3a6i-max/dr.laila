# ── Cal.com ───────────────────────────────────────────────────
# Settings → Developer → API keys  (https://app.cal.com/settings/developer/api-keys)
# Server-side only. Never commit the real key.
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Timezone the practice works in. Slots are shown to visitors in this zone.
CAL_TIMEZONE=Asia/Riyadh

# Optional: lock the API to your own domain instead of allowing any origin.
# SITE_ORIGIN=https://drdalal.com
