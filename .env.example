# ══════════════════════════════════════════════════════════════
# Copy to .env for local use, or paste into your host's
# environment variables. NEVER commit the real values.
# ══════════════════════════════════════════════════════════════

# ── Cal.com ───────────────────────────────────────────────────
# Settings → Developer → API keys  (https://app.cal.com/settings/developer/api-keys)
# Required: confirming a booking always needs the key.
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Timezone the practice works in. Visitors always see this zone.
CAL_TIMEZONE=Asia/Riyadh

# Only for a self-hosted Cal.com instance.
# CAL_API_BASE=https://cal.example.com/api/v2

# ── Supabase (booking requests + payment screenshots) ─────────
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key. Bypasses row security, so it is SERVER ONLY.
# If this ever leaks, rotate it immediately in Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Admin dashboard ───────────────────────────────────────────
# Generate both with:  node scripts/hash-password.js "your password"
ADMIN_PASSWORD_HASH=scrypt$...$...
SESSION_SECRET=64-hex-characters

# How long a dashboard sign-in lasts, in hours (default 12).
# SESSION_HOURS=12

# Only for local http:// development — never set this in production,
# it drops the Secure flag from the session cookie.
# ALLOW_INSECURE_COOKIE=true

# Optional: restrict the public API to your own domain.
# SITE_ORIGIN=https://drdalal.com
